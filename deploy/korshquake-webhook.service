[Unit]
Description=KorshQuake GitHub Webhook Listener
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/korshquake
ExecStart=/usr/bin/python3 /opt/korshquake/webhook_listener.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
